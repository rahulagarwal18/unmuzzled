    "qwen",
    "ai"
  ],
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.11.1",
    "marked": "^18.1.3",
    "node-llama-cpp": "^3.22.3"
  }
}
