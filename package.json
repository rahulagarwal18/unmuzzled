{
  "name": "unmuzzled",
  "version": "0.1.0",
  "description": "Private, offline AI chat for local GGUF models. One command to download, run and talk.",
  "author": "Rahul Agarwal (https://github.com/rahulagarwal18)",
  "license": "MIT",
  "homepage": "https://github.com/rahulagarwal18/unmuzzled#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulagarwal18/unmuzzled.git"
  },
  "bugs": {
    "url": "https://github.com/rahulagarwal18/unmuzzled/issues"
  },
  "type": "module",
  "bin": {
    "unmuzzled": "bin/unmuzzled.js"
  },
  "files": [
    "bin",
    "src",
    "public"
  ],
  "scripts": {
